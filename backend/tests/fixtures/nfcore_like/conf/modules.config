process {
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }, mode: 'copy' ]

    withName: '.*:FASTQC' {
        ext.args = '--quiet'
    }
    withName: 'NFCORE_DEMO:DEMO:TRIMGALORE' {
        ext.args = { "--fastqc --length ${params.min_length ?: 20}" }
    }
    withName: '.*:FASTQC_TRIMMED|.*:MULTIQC' {
        ext.prefix = { "${meta.id}_trimmed" }
    }
}
