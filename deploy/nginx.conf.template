# Serves the UI and proxies the API to the native controller on loopback.
# For TLS: place fullchain.pem/privkey.pem in deploy/certs and use the second server block
# (or terminate TLS with your institution's reverse proxy / `tailscale serve`).
server {
    listen ${BIOCOMPUTE_WEB_PORT};
    server_name _;
    client_max_body_size 50m;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://127.0.0.1:8045;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;              # server-sent events (live logs)
        proxy_read_timeout 1h;
    }
    location /openapi.json { proxy_pass http://127.0.0.1:8045; }
    location /docs { proxy_pass http://127.0.0.1:8045; }
    location / {
        try_files $uri /index.html;
        add_header X-Content-Type-Options nosniff;
    }
}

