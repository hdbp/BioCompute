# ---- BioCompute controller configuration (copy to backend/.env or /etc/biocompute/biocompute.env) ----
BIOCOMPUTE_ENVIRONMENT=production
# PostgreSQL started by docker compose (bound to 127.0.0.1 only)
BIOCOMPUTE_DATABASE_URL=postgresql+psycopg://biocompute:change-me@127.0.0.1:5432/biocompute
POSTGRES_PASSWORD=change-me
# Where BioCompute keeps its own state (pipeline store, run directories, secrets)
BIOCOMPUTE_STATE_DIR=/var/lib/biocompute
# Initial admin. If BIOCOMPUTE_ADMIN_PASSWORD is empty a random one is written to $STATE_DIR/initial_admin_password.txt
BIOCOMPUTE_ADMIN_USERNAME=admin
BIOCOMPUTE_ADMIN_PASSWORD=
# Optional: JWT signing key (otherwise generated once and stored in $STATE_DIR/secret.key)
# BIOCOMPUTE_SECRET_KEY=
# Folders users can browse (more can be added in Settings -> Data folders). restricted=true data never leaves this controller's site.
BIOCOMPUTE_DATA_ROOTS=[{"name":"raw","path":"/path/to/raw/sequencing","restricted":true,"writable":false,"description":"Raw instrument data"},{"name":"analyses","path":"/path/to/analyses","restricted":false,"writable":true,"description":"Pipeline outputs"}]
BIOCOMPUTE_SITE_NAME=lab
# Optional: an existing refgenie genome_config.yaml (or its folder), used read-only. Default: $REFGENIE, then ~/.refgenie
# BIOCOMPUTE_REFGENIE_CONFIG=/data/refgenie/genome_config.yaml
# Execution
BIOCOMPUTE_NEXTFLOW_BIN=nextflow
BIOCOMPUTE_MAX_CONCURRENT_RUNS=4
BIOCOMPUTE_ALLOW_CUSTOM_CODE_MODULES=true
BIOCOMPUTE_ENABLE_DEMO_ENGINE=true
# Data Explorer: source of the public UCSC track hub list (cached 24 h). Empty = no outbound request.
# BIOCOMPUTE_EXPLORER_PUBLIC_HUBS_URL=https://api.genome.ucsc.edu/list/publicHubs
# Pipeline Studio assistant. Usually set in Settings -> AI assistant; these are fallbacks.
# Provider: off | anthropic | openai | claude-cli
# BIOCOMPUTE_AI_PROVIDER=off
# BIOCOMPUTE_AI_MODEL=
# Prefer saving keys in Settings (stored 0600 in the state dir). Otherwise the SDKs read:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Discovery. Active TCP probing only inside these CIDRs (comma separated). Empty = no active probing.
BIOCOMPUTE_DISCOVERY_AUTHORIZED_CIDRS=
BIOCOMPUTE_DISCOVERY_ENABLE_MDNS=true
BIOCOMPUTE_DISCOVERY_ENABLE_TAILSCALE=true
BIOCOMPUTE_DISCOVERY_ENABLE_HTCONDOR=true
BIOCOMPUTE_DISCOVERY_ENABLE_NEIGHBORS=true
# Agent-only listener so workers on other machines can enroll and send heartbeats
# ("tailscale" = this machine's tailnet IPv4, or "<ip>:<port>"). Only enroll/heartbeat/health are served there.
BIOCOMPUTE_AGENT_LISTEN=tailscale
BIOCOMPUTE_AGENT_PORT=8765
# One-click enrollment of tailnet machines over (Tailscale) SSH, admin-initiated
BIOCOMPUTE_ALLOW_SSH_ENROLLMENT=true
BIOCOMPUTE_SSH_BIN=ssh
# Address agents use to reach this controller (pre-fills enrollment), e.g. http://lab-ws.tail1234.ts.net:8080
# BIOCOMPUTE_PUBLIC_URL=
BIOCOMPUTE_CORS_ORIGINS=http://localhost:5173
