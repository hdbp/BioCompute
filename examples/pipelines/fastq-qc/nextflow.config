manifest {
    name            = 'biocompute/fastq-qc'
    author          = 'BioCompute'
    description     = 'Portable FASTQ quality control: per-sample read statistics and an HTML QC report'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

params {
    input             = null
    outdir            = 'results'
    min_read_length   = 50
    min_mean_quality  = 20
    max_reads         = 0
    report_title      = 'FASTQ QC report'
}

profiles {
    test {
        params.input  = "${projectDir}/assets/test_samplesheet.csv"
        params.outdir = 'results_test'
    }
    // No containers are needed: the pipeline uses bash, awk, gzip and python3.
    docker    { docker.enabled = true; process.container = 'python:3.12-slim' }
    apptainer { apptainer.enabled = true; process.container = 'docker://python:3.12-slim' }
}
